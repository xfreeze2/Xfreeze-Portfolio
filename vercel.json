{
  "rewrites": [
    { "source": "/about", "destination": "/index.html" },
    { "source": "/articles", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/support", "destination": "/index.html" },
    { "source": "/grok-bots", "destination": "/grok-bots.html" }
  ],
  "headers": [
    {
      "source": "/favicon.ico",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/favicon-(.*).png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(index.html|grok-bots.html|app.js|styles.css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/grok-bots/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
